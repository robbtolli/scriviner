---
interface Props {
  src?: string;
  title?: string;
  urlLabel?: string;
  initialWidth?: string;
  height?: string;
  showViewportToggles?: boolean;
  rightLinkHref?: string;
  rightLinkLabel?: string;
  rightLinkExternal?: boolean;
}

const {
  src = '/app/index.html?seed=true',
  title = 'Scrivener Interactive Flutter Web Preview',
  urlLabel = 'Scrivener',
  initialWidth = '100%',
  height = '680px',
  showViewportToggles = true,
  rightLinkHref = '/app/index.html?seed=true',
  rightLinkLabel = 'Full Screen ↗',
  rightLinkExternal = true,
} = Astro.props;

const activeMode =
  initialWidth === '390px' ? 'mobile' : initialWidth === '768px' ? 'tablet' : 'desktop';
---

<div class="live-frame-wrapper" data-live-frame>
  <div class="device-frame" style={`width: ${initialWidth}; max-width: 100%;`}>
    <div class="frame-bar">
      <div class="frame-left">
        <span class="live-pill">
          <span class="live-dot"></span>
          LIVE DEMO
        </span>
      </div>

      <span class="frame-url">{urlLabel}</span>

      <div class="frame-right">
        {showViewportToggles && (
          <div class="viewport-toggles" role="group" aria-label="Preview viewport size">
            <button
              type="button"
              class:list={['vp-btn', { active: activeMode === 'mobile' }]}
              data-width="390px"
              title="Mobile Phone View"
            >
              Mobile
            </button>
            <button
              type="button"
              class:list={['vp-btn', { active: activeMode === 'tablet' }]}
              data-width="768px"
              title="Tablet View"
            >
              Tablet
            </button>
            <button
              type="button"
              class:list={['vp-btn', { active: activeMode === 'desktop' }]}
              data-width="100%"
              title="Desktop View"
            >
              Desktop
            </button>
          </div>
        )}
        <a
          href={rightLinkHref}
          target={rightLinkExternal ? '_blank' : undefined}
          rel={rightLinkExternal ? 'noreferrer' : undefined}
          class="frame-link"
        >
          {rightLinkLabel}
        </a>
      </div>
    </div>

    <div class="iframe-container" style={`--frame-height: ${height};`}>
      <div class="iframe-loader" data-loader>
        <div class="loader-spinner"></div>
        <span>Initializing Scrivener WebAssembly…</span>
      </div>
      <iframe
        src={src}
        title={title}
        allow="cross-origin-isolated; fullscreen"
        data-iframe
      ></iframe>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-live-frame]').forEach((root) => {
    const deviceFrame = root.querySelector('.device-frame') as HTMLElement | null;
    const buttons = root.querySelectorAll('.vp-btn');
    const iframe = root.querySelector('[data-iframe]') as HTMLIFrameElement | null;
    const loader = root.querySelector('[data-loader]') as HTMLElement | null;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const targetWidth = btn.getAttribute('data-width');
        if (deviceFrame && targetWidth) {
          deviceFrame.style.width = targetWidth;
        }
      });
    });

    if (iframe && loader) {
      const hideLoader = () => {
        loader.classList.add('hidden');
      };
      iframe.addEventListener('load', hideLoader, { once: true });
      // Fallback in case load already fired before script attached
      setTimeout(hideLoader, 4000);
    }
  });
</script>

<style>
  .live-frame-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .device-frame {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75);
    overflow: hidden;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .frame-bar {
    min-height: 42px;
    background: #090d16;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    color: #64748b;
    flex-wrap: wrap;
  }

  .frame-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 6px #34d399;
  }

  .frame-url {
    font-family: monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .frame-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .viewport-toggles {
    display: inline-flex;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.15rem;
    gap: 0.15rem;
  }

  .vp-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .vp-btn:hover {
    color: #fff;
  }

  .vp-btn.active {
    background: var(--color-surface-hover);
    color: #fff;
  }

  .frame-link {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .frame-link:hover {
    text-decoration: underline;
  }

  .iframe-container {
    width: 100%;
    height: var(--frame-height, 680px);
    position: relative;
    background: #090d16;
  }

  .iframe-container iframe {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .iframe-loader {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: #090d16;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .iframe-loader.hidden {
    opacity: 0;
  }

  .loader-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(192, 132, 252, 0.2);
    border-top-color: #c084fc;
    border-radius: 50%;
    animation: spin 0.85s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .frame-url,
    .viewport-toggles {
      display: none;
    }

    .iframe-container {
      height: 540px;
    }
  }
</style>
