---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Download Scrivener — Cross-Platform TTRPG Companion"
  description="Download Scrivener for Android, Linux, Windows, macOS, and Web. 100% offline-first with zero accounts or subscriptions."
>
  <section class="download-page">
    <div class="container">
      <div class="page-header">
        <div class="tag">Release Binaries & Setup</div>
        <h1>Download Scrivener</h1>
        <p class="subtitle">
          Scrivener is 100% offline-first. Your characters, spell lists, and campaign notes remain on your device in high-performance local SQLite.
        </p>
      </div>

      <!-- Main Download Cards Grid -->
      <div class="downloads-grid">
        <!-- Android -->
        <div class="download-card highlight-card">
          <div class="card-icon">🤖</div>
          <div class="card-badge">Most Popular</div>
          <h3>Android</h3>
          <p class="card-desc">Requires Android 8.0 (Oreo) or higher. Optimized for phones and tablets in portrait and landscape.</p>
          <div class="card-actions">
            <a href="https://github.com/robb/scrivener/releases" target="_blank" rel="noreferrer" class="btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              <span>Download APK</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Package: <code>com.tollitech.scrivener</code></span>
          </div>
        </div>

        <!-- Linux Desktop -->
        <div class="download-card">
          <div class="card-icon">🐧</div>
          <h3>Linux Desktop</h3>
          <p class="card-desc">64-bit native GTK application for Ubuntu, Fedora, Arch, Debian, and all major distributions.</p>
          <div class="card-actions">
            <a href="https://github.com/robb/scrivener/releases" target="_blank" rel="noreferrer" class="btn-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              <span>Download Linux Binary (x86_64)</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Includes native SQLite bindings</span>
          </div>
        </div>

        <!-- Windows -->
        <div class="download-card">
          <div class="card-icon">🪟</div>
          <h3>Windows</h3>
          <p class="card-desc">Native Windows 10 & 11 (x64) application with system dark mode and multi-window dice tray support.</p>
          <div class="card-actions">
            <a href="https://github.com/robb/scrivener/releases" target="_blank" rel="noreferrer" class="btn-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              <span>Download Windows Zip (x64)</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Portable standalone executable</span>
          </div>
        </div>

        <!-- macOS -->
        <div class="download-card">
          <div class="card-icon">🍏</div>
          <h3>macOS</h3>
          <p class="card-desc">Universal binary supporting both Apple Silicon (M1/M2/M3/M4) and Intel Macs running macOS 11+.</p>
          <div class="card-actions">
            <a href="https://github.com/robb/scrivener/releases" target="_blank" rel="noreferrer" class="btn-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              <span>Download macOS DMG</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Metal-accelerated graphics</span>
          </div>
        </div>

        <!-- Web Browser -->
        <div class="download-card">
          <div class="card-icon">🌐</div>
          <h3>Web App / PWA</h3>
          <p class="card-desc">Runs entirely in Chrome, Firefox, Safari, or Edge via WebAssembly. Works offline using browser OPFS SQLite.</p>
          <div class="card-actions">
            <a href="/demo/" class="btn-cta">
              <span>Launch In Browser</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Zero installation required</span>
          </div>
        </div>

        <!-- Dice Caster Standalone -->
        <div class="download-card">
          <div class="card-icon">🎲</div>
          <h3>Dice Caster (Standalone)</h3>
          <p class="card-desc">Ultra-lightweight polyhedral dice roller companion for quick rolls during any tabletop roleplaying game.</p>
          <div class="card-actions">
            <a href="/dice/" class="btn-secondary">
              <span>Open Dice Caster</span>
            </a>
          </div>
          <div class="card-notes">
            <span>Flavor: <code>com.tollitech.dicecaster</code></span>
          </div>
        </div>
      </div>

      <!-- Installation Instructions -->
      <div class="install-instructions">
        <h2>Installation & Setup Instructions</h2>

        <div class="instructions-accordion">
          <div class="instruction-block">
            <h3>📱 Installing on Android (Sideloading APK)</h3>
            <ol>
              <li>Download the <code>scrivener-release.apk</code> file to your device or browser.</li>
              <li>When prompted by Android, tap <strong>Settings</strong> and enable <em>"Allow from this source"</em> for your browser or file manager.</li>
              <li>Tap <strong>Install</strong>. Once completed, Scrivener will appear in your app drawer.</li>
              <li>Scrivener requires zero special permissions (no camera, no location, no contacts, no network required for local gameplay).</li>
            </ol>
          </div>

          <div class="instruction-block">
            <h3>💻 Building From Source (Developers & Linux Enthusiasts)</h3>
            <p style="margin-bottom: 0.75rem; color: #cbd5e1;">If you prefer to compile Scrivener directly with Flutter:</p>
            <pre><code># 1. Clone the repository
git clone https://github.com/robb/scrivener.git
cd scrivener

# 2. Fetch Flutter packages
flutter pub get

# 3. Run on your desired platform
flutter run -d linux      # Run natively on Linux
flutter run -d chrome     # Run in Chrome with SQLite WASM
flutter run --flavor dice # Run standalone Dice Caster</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .download-page {
    padding: 4.5rem 0 6rem;
  }

  .page-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .tag {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: 4.5rem;
  }

  .download-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .download-card:hover {
    transform: translateY(-3px);
    border-color: rgba(192, 132, 252, 0.4);
  }

  .highlight-card {
    border-color: rgba(147, 51, 234, 0.5);
    background: linear-gradient(180deg, rgba(88, 28, 135, 0.15) 0%, rgba(17, 24, 39, 0.95) 100%);
  }

  .card-icon {
    font-size: 2.25rem;
    margin-bottom: 1rem;
  }

  .card-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(192, 132, 252, 0.2);
    border: 1px solid rgba(192, 132, 252, 0.4);
    color: #e9d5ff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }

  .download-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
    line-height: 1.5;
    flex: 1;
  }

  .card-actions {
    margin-bottom: 1.25rem;
  }

  .card-actions a {
    width: 100%;
    justify-content: center;
  }

  .card-notes {
    font-size: 0.8rem;
    color: #64748b;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .card-notes code {
    color: #cbd5e1;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #9333ea, #c084fc);
    color: #fff;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 4px 15px rgba(147, 51, 234, 0.3);
  }

  /* Instructions */
  .install-instructions {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .install-instructions h2 {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .instruction-block {
    margin-bottom: 2.25rem;
  }

  .instruction-block:last-child {
    margin-bottom: 0;
  }

  .instruction-block h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    color: #f3f4f6;
  }

  .instruction-block ol {
    margin-left: 1.5rem;
    color: #cbd5e1;
    line-height: 1.8;
  }

  .instruction-block pre {
    background: #090d16;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    color: #e2e8f0;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .page-header h1 {
      font-size: 2.25rem;
    }
  }
</style>
